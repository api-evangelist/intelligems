{
  "opencollection": "1.0.0",
  "info": {
    "name": "Intelligems External Holiday Benchmark API",
    "version": "v25-10-beta"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "intelligems-access-token",
      "value": "{{intelligems-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Holiday Benchmark",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch benchmark event snapshot",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.intelligems.io/v25-10-beta/analytics/event/snapshot",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Benchmark event snapshot metrics for a seasonal event."
        },
        {
          "info": {
            "name": "Fetch benchmark event timeseries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.intelligems.io/v25-10-beta/analytics/event/timeseries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Benchmark event metric-over-time data."
        }
      ]
    }
  ],
  "bundled": true
}